SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000
DEVICE_API_KEY=replace-with-a-random-string-of-at-least-32-characters

# MQTT (INA219 telemetry from the ESP32). The backend is an MQTT client, so it needs an external broker.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_TOPIC_PREFIX=sunsync
